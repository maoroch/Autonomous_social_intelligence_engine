# Используется docker-compose для подстановки в переменные окружения сервисов.
# Скопируйте в .env и заполните реальными ключами.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Публичный домен, на котором openclaw раздаёт изображения (GET /images/:id).
# ОБЯЗАТЕЛЕН для agent-publishing при публикации в Instagram (Graph API требует
# реальный публичный image_url, localhost не подходит). Пример: https://api.yourdomain.com
OPENCLAW_PUBLIC_BASE_URL=