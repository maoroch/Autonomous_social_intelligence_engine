FROM node:20-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json* ./
COPY web-dashboard/package.json ./web-dashboard/package.json
RUN npm install

FROM deps AS build
COPY . .
RUN npm run build -w web-dashboard

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /app/web-dashboard/.next ./web-dashboard/.next
COPY --from=build /app/web-dashboard/public ./web-dashboard/public
COPY --from=build /app/web-dashboard/package.json ./web-dashboard/package.json
COPY --from=build /app/node_modules ./node_modules
WORKDIR /app/web-dashboard
EXPOSE 3000
CMD ["npm", "run", "start"]
